{
  "manifestVersion": 2,
  "id": "blender-bridge",
  "name": "Blender 助手",
  "version": "1.64.0",
  "description": "本地建模：AI 看视口、跑代码、按参考图还原外形。",
  "entry": "index.js",
  "icon": "assets/icon-v2.png",
  "minAppVersion": "0.944.0",
  "network": {
    "allowedHosts": [
      "127.0.0.1"
    ],
    "methods": [
      "GET",
      "POST"
    ],
    "allowLocalhost": true,
    "defaultTimeoutMs": 30000,
    "maxResponseBytes": 16777216
  },
  "capabilities": [
    "app/tools.expose-to-model",
    "app/runtime.execute",
    "app/runtime.local-machine",
    "app/runtime.network",
    "app/resources.read",
    "app/resources.write",
    "app/tasks.manage",
    "app/session.start-turn",
    "app/sessions.manage",
    "app/sessions.read",
    "app/agents.read",
    "app/session.switch-model"
  ],
  "contributes": {
    "cards": [
      {
        "id": "workbench",
        "title": "Blender 助手",
        "description": "整页工作台：产出归档（run 列表 + 主图 + 产物清单）、标基线、写意见、视口取景、场景树、bpy 执行、设置。",
        "route": "/workbench.html",
        "realization": "page",
        "siteNavEntry": true,
        "fpFullPanel": true,
        "closable": false,
        "cardForm": "flush",
        "titlebar": "solid",
        "functionPanel": {
          "id": "status",
          "label": "Blender 状态",
          "route": "/sidepanel.html"
        },
        "detached": {
          "route": "/workbench.html"
        },
        "face": {
          "image": "assets/cover-v2.png"
        }
      }
    ]
  }
}
